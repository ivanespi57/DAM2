<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
    version="3.1">

    <!-- ================= TU TIENDA (la que ya tenías) ================= -->
    <persistence-unit name="TIENDA_ORM_PU" transaction-type="RESOURCE_LOCAL">
        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>
        <class>tienda_orm.Producto</class>
        <class>tienda_orm.FichaTecnica</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://192.168.3.175:3306/tienda_orm"/>
            <property name="jakarta.persistence.jdbc.user" value="ivan"/>
            <property name="jakarta.persistence.jdbc.password" value="ivan"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>

